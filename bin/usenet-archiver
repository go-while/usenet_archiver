#!/usr/bin/env bash
# Dev launcher — run the package without installing (GUI by default; -c for CLI).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# the package lives in the repo root: found from any working directory
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
if [[ -x "$ROOT/.venv/bin/python" ]]; then
  exec "$ROOT/.venv/bin/python" -m usenet_archiver "$@"
fi
exec python3 -m usenet_archiver "$@"
